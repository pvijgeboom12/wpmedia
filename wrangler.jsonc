{
  // Cloudflare Workers config for waterproofmedia.com
  "name": "wpmedia",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  // Required by `npx wrangler preview` (Cloudflare branch builds). Empty = inherit top-level settings.
  "previews": {},
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
