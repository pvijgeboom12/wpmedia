{
  // Cloudflare Workers config for waterproofmedia.com
  "name": "wpmedia",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
